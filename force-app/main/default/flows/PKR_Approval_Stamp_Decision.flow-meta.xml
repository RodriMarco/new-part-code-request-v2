<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Reopen_With_History</name>
        <label>Reopen With History</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Previous_Decisions__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>HistoryLine</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Previous_Decisions__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NewLine</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Round__c</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Clear_Decision</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Clear_Decision</name>
        <label>Clear Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Decision_By__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Decision_Date__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Comments__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Stamp_Decision</name>
        <label>Stamp Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Decision_By__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Decision_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Had_Decision</name>
        <label>Had a Decision?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Clear_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No decision recorded</defaultConnectorLabel>
        <rules>
            <name>Decided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Decision_By__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Prior_Decider</targetReference>
            </connector>
            <label>Decided</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_Status</name>
        <label>Which Status?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stamp_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Approved or Rejected</defaultConnectorLabel>
        <rules>
            <name>Back_To_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Had_Decision</targetReference>
            </connector>
            <label>Back to Pending</label>
        </rules>
    </decisions>
    <description>When the Status of an Approval changes to Approved or Rejected, records who decided and when. When it goes back to Pending (resend or manual re-approval of a single approval), appends the previous decision to Previous Decisions, starts a new round and clears the decision fields and comments.</description>
    <environments>Default</environments>
    <formulas>
        <name>HistoryLine</name>
        <dataType>String</dataType>
        <expression>&quot;Round &quot; &amp; TEXT({!$Record__Prior.Round__c}) &amp; &quot;: &quot; &amp; TEXT({!$Record__Prior.Status__c}) &amp; &quot; by &quot; &amp; {!Get_Prior_Decider.Name} &amp; &quot; on &quot; &amp; TEXT({!$Record__Prior.Decision_Date__c}) &amp; IF(ISBLANK({!$Record__Prior.Comments__c}), &quot;&quot;, &quot; - &quot; &amp; {!$Record__Prior.Comments__c})</expression>
    </formulas>
    <interviewLabel>PKR Approval Stamp Decision {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PKR Approval Stamp Decision</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Prior_Decider</name>
        <label>Get Prior Decider</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Reopen_With_History</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.Decision_By__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Which_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PKR_Approval__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>NewLine</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>
</text>
    </textTemplates>
</Flow>
