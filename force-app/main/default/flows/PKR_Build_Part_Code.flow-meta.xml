    <decisions>
        <name>Already_Built</name>
        <label>Already Built?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not built yet</defaultConnectorLabel>
        <rules>
            <name>Has_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Part_Code.Product__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Skipped</targetReference>
            </connector>
            <label>Has Product</label>
        </rules>
    </decisions>
    <decisions>
        <name>Product_Exists</name>
        <label>Product Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create new</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Product</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Existing_Product</targetReference>
            </connector>
            <label>Found by Source Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Price</name>
        <label>Has Price?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Cost</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No price</defaultConnectorLabel>
        <rules>
            <name>Any_Price</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Part_Code.Price_Americas__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Part_Code.Price_EMEA__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Standard_Entries</targetReference>
            </connector>
            <label>Americas or EMEA price</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Standard_Error</name>
        <label>Standard Entries OK?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Pricebook_Entries</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Standard_Failed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubflowError</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Subflow_Fault</targetReference>
            </connector>
            <label>Failed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Pricebook_Error</name>
        <label>Pricebook Entries OK?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Cost</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Pricebook_Failed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubflowError</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Subflow_Fault</targetReference>
            </connector>
            <label>Failed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Cost</name>
        <label>Has Cost?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Part_Code</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No cost</defaultConnectorLabel>
        <rules>
            <name>Cost_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Part_Code.Cost__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Cost_Entries</targetReference>
            </connector>
            <label>Cost present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Cost_Error</name>
        <label>Cost Entries OK?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Part_Code</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Cost_Failed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubflowError</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Subflow_Fault</targetReference>
            </connector>
            <label>Failed</label>
        </rules>
    </decisions>
    <description>Creates the Product2 (active, USD, list pricing) for one Part Code, then its Standard and ChyronHego pricebook entries and CPQ costs through the PKR_ subflows. Idempotent: skips Part Codes that already have a Product and reuses a Product2 whose Source_PCR_Id__c matches. Errors are written to the Part Code instead of failing the caller.</description>
    <environments>Default</environments>
    <formulas>
        <name>BuiltStatusValue</name>
        <dataType>String</dataType>
        <expression>IF({!BuildTarget} = &quot;Sandbox&quot;, &quot;Built in Sandbox&quot;, &quot;Built in Production&quot;)</expression>
    </formulas>
    <formulas>
        <name>SourceKey</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Part_Code.Prod_Part_Code_Id__c}), CASESAFEID({!Get_Part_Code.Id}), {!Get_Part_Code.Prod_Part_Code_Id__c})</expression>
    </formulas>
    <formulas>
        <name>StandardBasePrice</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!Get_Part_Code.Price_Americas__c}, {!Get_Part_Code.Price_EMEA__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TruncatedLongDescription</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Part_Code.Long_Description__c}, 5000)</expression>
    </formulas>
    <interviewLabel>PKR Build Part Code {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PKR Build Part Code</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Product</name>
        <label>Create Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>ProductId</assignRecordIdToReference>
        <connector>
            <targetReference>Has_Price</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <stringValue>USD</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Get_Part_Code.Short_Description__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Extended_Description__c</field>
            <value>
                <elementReference>TruncatedLongDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Family</field>
            <value>
                <elementReference>Get_Part_Code.Product_Family__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsActive</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Get_Part_Code.Product_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProductCode</field>
            <value>
                <elementReference>Get_Part_Code.Product_Code__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product_Category__c</field>
            <value>
                <elementReference>Get_Part_Code.Product_Category__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SBQQ__PricingMethod__c</field>
            <value>
                <stringValue>List</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_PCR_Id__c</field>
            <value>
                <elementReference>SourceKey</elementReference>
            </value>
        </inputAssignments>
        <object>Product2</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Product</name>
        <label>Get Existing Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Product_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Source_PCR_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>SourceKey</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Product2</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
