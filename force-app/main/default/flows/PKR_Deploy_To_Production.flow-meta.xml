    <decisions>
        <name>Any_Built</name>
        <label>Any Built?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Summary_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Otherwise</defaultConnectorLabel>
        <rules>
            <name>Built_Some</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BuiltCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Request</targetReference>
            </connector>
            <label>Built at least one</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Permission</name>
        <label>Has Permission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not allowed</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.PKR_Deploy_Products</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Request</targetReference>
            </connector>
            <label>Allowed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status</name>
        <label>Is Approved?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Not_Approved_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not approved</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Request.Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Part_Codes</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Part_Codes</name>
        <label>Has Part Codes?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Part_Codes_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Some</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Part_Codes</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_List</targetReference>
            </connector>
            <label>Has part codes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tally</name>
        <label>Tally Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Count_Skipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Skipped</defaultConnectorLabel>
        <rules>
            <name>Built</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Built</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_Built</targetReference>
            </connector>
            <label>Built</label>
        </rules>
        <rules>
            <name>Errored</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Error</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_Error</targetReference>
            </connector>
            <label>Error</label>
        </rules>
    </decisions>
    <description>Admin-only. Creates the product, prices and costs in this org for every Part Code of the request by calling PKR_Build_Part_Code. Launched from the Deploy to Production quick action.</description>
    <environments>Default</environments>
    <formulas>
        <name>ErrorLine</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;li&gt;&lt;b&gt;&quot; &amp; {!Loop_Deploy.Product_Name__c} &amp; &quot;&lt;/b&gt; (&quot; &amp; {!Loop_Deploy.Product_Code__c} &amp; &quot;): &quot; &amp; {!SubError} &amp; &quot;&lt;/li&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>ListLine</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;li&gt;&lt;b&gt;&quot; &amp; {!Loop_List.Product_Name__c} &amp; &quot;&lt;/b&gt; (&quot; &amp; {!Loop_List.Product_Code__c} &amp; &quot;) &amp;#8211; &quot; &amp; TEXT({!Loop_List.Build_Status__c}) &amp; &quot;&lt;/li&gt;&quot;</expression>
    </formulas>
    <interviewLabel>PKR Deploy To Production {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PKR Deploy To Production</label>
    <loops>
        <name>Loop_Deploy</name>
        <label>Loop Deploy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Part_Codes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Part_Code</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Any_Built</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_List</name>
        <label>Loop List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Part_Codes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_List_Line</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Confirm_Screen</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
