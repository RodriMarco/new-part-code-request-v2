<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Cost_instance</name>
        <label>Cost instance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Var_Costentry.CurrencyIsoCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>thru_available_currencies.IsoCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Var_Costentry.SBQQ__Product__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Var_Input_Product_Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Var_Costentry.SBQQ__Active__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Var_Costentry.SBQQ__UnitCost__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Calc_Currency</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Instance_add_to_list</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Instance_add_to_list</name>
        <label>Instance add to list</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CostEntryListToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Var_Costentry</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>thru_available_currencies</targetReference>
        </connector>
    </assignments>
    <description>PKR v2 copy of PCR_Cost_entries_creation. Called by PKR_Build_Part_Code. Reports DML failures through the ErrorMessage output instead of failing the caller.</description>
    <environments>Default</environments>
    <formulas>
        <name>Calc_Currency</name>
        <dataType>Currency</dataType>
        <expression>CURRENCYRATE(TEXT({!thru_available_currencies.IsoCode}))*BLANKVALUE({!Var_Usdpriceinput}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>PKR Cost entries creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PKR Cost entries creation</label>
    <loops>
        <name>thru_available_currencies</name>
        <label>thru available currencies</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>VarColl_Currencies_Types</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Cost_instance</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_cost_entries</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
