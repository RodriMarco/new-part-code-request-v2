        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>thru_available_currencies</targetReference>
        </connector>
        <object>CurrencyType</object>
        <outputReference>VarColl_Currencies_Types</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>IsoCode</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
