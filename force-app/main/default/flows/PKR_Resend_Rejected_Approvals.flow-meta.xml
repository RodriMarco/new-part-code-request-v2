    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Prepare_Resend</name>
        <label>Prepare Resend</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Rejected.Previous_Decisions__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>HistoryLine</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Rejected.Previous_Decisions__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NewLine</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Rejected.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Rejected.Round__c</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Rejected.Comments__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ApprovalsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Rejected</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ResentCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Rejected</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Rejected</name>
        <label>Has Rejected Approvals?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Some</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Rejected</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Rejected</targetReference>
            </connector>
            <label>Some</label>
        </rules>
    </decisions>
    <description>Core of Resend Approvals (autolaunched so it can be tested and reused): resets every Rejected approval of the request to Pending (new round), keeps the rejection in Previous Decisions, sets the request back to Pending and notifies the approvers again.</description>
    <environments>Default</environments>
    <formulas>
        <name>HistoryLine</name>
        <dataType>String</dataType>
        <expression>&quot;Round &quot; &amp; TEXT({!Loop_Rejected.Round__c}) &amp; &quot;: Rejected by &quot; &amp; {!Get_Decider.Name} &amp; &quot; on &quot; &amp; TEXT({!Loop_Rejected.Decision_Date__c}) &amp; IF(ISBLANK({!Loop_Rejected.Comments__c}), &quot;&quot;, &quot; - &quot; &amp; {!Loop_Rejected.Comments__c})</expression>
    </formulas>
    <formulas>
        <name>NotificationBody</name>
        <dataType>String</dataType>
        <expression>&quot;Request &quot; &amp; {!Get_Request.Name} &amp; &quot; (&quot; &amp; {!Get_Request.Title__c} &amp; &quot;) was updated and resent for your approval (&quot; &amp; {!Loop_Notify.Sector__c} &amp; &quot;, round &quot; &amp; TEXT({!Loop_Notify.Round__c}) &amp; &quot;).&quot;</expression>
    </formulas>
    <interviewLabel>PKR Resend Rejected Approvals {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PKR Resend Rejected Approvals</label>
    <loops>
